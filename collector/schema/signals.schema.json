{
  "$defs": {
    "SteamGame": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "description": "Stable id shared with the web (gtav, rdr2, cs2, ...)",
          "title": "Key",
          "type": "string"
        },
        "app_id": {
          "title": "App Id",
          "type": "integer"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "current_players": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Current Players"
        },
        "current_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Current At"
        },
        "peak_24h": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Max single reading in the 24h before generated_at. When peak_24h_partial is true the readings only go back to peak_24h_since, so this is the max of a shorter window",
          "title": "Peak 24H"
        },
        "observed_peak": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Max single reading since tracking began",
          "title": "Observed Peak"
        },
        "observed_peak_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Observed Peak At"
        },
        "series_24h": {
          "description": "Exactly 25 hourly points, oldest first, ending with the current hour",
          "items": {
            "$ref": "#/$defs/SteamPoint"
          },
          "maxItems": 25,
          "minItems": 25,
          "title": "Series 24H",
          "type": "array"
        },
        "peak_24h_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "When the peak_24h reading was taken (earliest, on a tie)",
          "title": "Peak 24H At"
        },
        "peak_24h_since": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Oldest reading inside the 24h window: where peak_24h's window really starts",
          "title": "Peak 24H Since"
        },
        "peak_24h_partial": {
          "default": false,
          "description": "True when peak_24h_since is more than 15 minutes after generated_at minus 24h (tracking began, or resumed after an outage, inside the window), so peak_24h covers less than 24 hours",
          "title": "Peak 24H Partial",
          "type": "boolean"
        }
      },
      "required": [
        "key",
        "app_id",
        "name",
        "current_players",
        "current_at",
        "peak_24h",
        "observed_peak",
        "observed_peak_at",
        "series_24h"
      ],
      "title": "SteamGame",
      "type": "object"
    },
    "SteamPoint": {
      "additionalProperties": false,
      "properties": {
        "hour": {
          "description": "Start of the UTC hour bucket",
          "format": "date-time",
          "title": "Hour",
          "type": "string"
        },
        "players": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Mean of readings in the hour; null if none",
          "title": "Players"
        }
      },
      "required": [
        "hour",
        "players"
      ],
      "title": "SteamPoint",
      "type": "object"
    },
    "SteamSignals": {
      "additionalProperties": false,
      "properties": {
        "tracking_since": {
          "format": "date-time",
          "title": "Tracking Since",
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        },
        "games": {
          "items": {
            "$ref": "#/$defs/SteamGame"
          },
          "title": "Games",
          "type": "array"
        }
      },
      "required": [
        "tracking_since",
        "updated_at",
        "games"
      ],
      "title": "SteamSignals",
      "type": "object"
    },
    "TwitchGameSummary": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "title": "Key",
          "type": "string"
        },
        "game_id": {
          "title": "Game Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "current_viewers": {
          "title": "Current Viewers",
          "type": "integer"
        },
        "current_streams": {
          "title": "Current Streams",
          "type": "integer"
        },
        "peak_viewers": {
          "title": "Peak Viewers",
          "type": "integer"
        },
        "peak_at": {
          "format": "date-time",
          "title": "Peak At",
          "type": "string"
        }
      },
      "required": [
        "key",
        "game_id",
        "name",
        "current_viewers",
        "current_streams",
        "peak_viewers",
        "peak_at"
      ],
      "title": "TwitchGameSummary",
      "type": "object"
    },
    "TwitchHourPoint": {
      "additionalProperties": false,
      "properties": {
        "hour": {
          "description": "Start of the UTC hour bucket",
          "format": "date-time",
          "title": "Hour",
          "type": "string"
        },
        "hours_from_launch": {
          "description": "hour minus launch, in whole hours",
          "title": "Hours From Launch",
          "type": "integer"
        },
        "avg_viewers": {
          "title": "Avg Viewers",
          "type": "integer"
        },
        "max_viewers": {
          "title": "Max Viewers",
          "type": "integer"
        },
        "samples": {
          "description": "Snapshots that fell in this hour",
          "title": "Samples",
          "type": "integer"
        }
      },
      "required": [
        "hour",
        "hours_from_launch",
        "avg_viewers",
        "max_viewers",
        "samples"
      ],
      "title": "TwitchHourPoint",
      "type": "object"
    },
    "TwitchLanguage": {
      "additionalProperties": false,
      "properties": {
        "language": {
          "description": "Twitch stream language (ISO 639-1, or 'other')",
          "title": "Language",
          "type": "string"
        },
        "viewers": {
          "title": "Viewers",
          "type": "integer"
        },
        "streams": {
          "title": "Streams",
          "type": "integer"
        },
        "share": {
          "description": "viewers / total viewers, 0..1",
          "title": "Share",
          "type": "number"
        }
      },
      "required": [
        "language",
        "viewers",
        "streams",
        "share"
      ],
      "title": "TwitchLanguage",
      "type": "object"
    },
    "TwitchSignals": {
      "additionalProperties": false,
      "properties": {
        "game_id": {
          "title": "Game Id",
          "type": "string"
        },
        "game_name": {
          "title": "Game Name",
          "type": "string"
        },
        "tracking_since": {
          "description": "First snapshot; nothing before is known",
          "format": "date-time",
          "title": "Tracking Since",
          "type": "string"
        },
        "updated_at": {
          "description": "Latest snapshot",
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        },
        "current_viewers": {
          "title": "Current Viewers",
          "type": "integer"
        },
        "current_streams": {
          "title": "Current Streams",
          "type": "integer"
        },
        "current_truncated": {
          "description": "True if the latest snapshot stopped before the last page (safety page cap, time budget, rate limit or a failing page), so the long tail is not counted",
          "title": "Current Truncated",
          "type": "boolean"
        },
        "peak_viewers": {
          "title": "Peak Viewers",
          "type": "integer"
        },
        "peak_at": {
          "format": "date-time",
          "title": "Peak At",
          "type": "string"
        },
        "hours_watched": {
          "description": "Estimate since tracking_since: trapezoid integral of total viewers over time, skipping gaps longer than 15 minutes",
          "title": "Hours Watched",
          "type": "integer"
        },
        "hourly": {
          "items": {
            "$ref": "#/$defs/TwitchHourPoint"
          },
          "title": "Hourly",
          "type": "array"
        },
        "by_language": {
          "description": "Latest snapshot, viewers desc",
          "items": {
            "$ref": "#/$defs/TwitchLanguage"
          },
          "title": "By Language",
          "type": "array"
        },
        "top_streams": {
          "description": "Latest snapshot, top 10",
          "items": {
            "$ref": "#/$defs/TwitchStream"
          },
          "title": "Top Streams",
          "type": "array"
        },
        "comparison": {
          "description": "Other categories, e.g. GTA V",
          "items": {
            "$ref": "#/$defs/TwitchGameSummary"
          },
          "title": "Comparison",
          "type": "array"
        }
      },
      "required": [
        "game_id",
        "game_name",
        "tracking_since",
        "updated_at",
        "current_viewers",
        "current_streams",
        "current_truncated",
        "peak_viewers",
        "peak_at",
        "hours_watched",
        "hourly",
        "by_language",
        "top_streams",
        "comparison"
      ],
      "title": "TwitchSignals",
      "type": "object"
    },
    "TwitchStream": {
      "additionalProperties": false,
      "properties": {
        "user_login": {
          "title": "User Login",
          "type": "string"
        },
        "viewer_count": {
          "title": "Viewer Count",
          "type": "integer"
        },
        "language": {
          "title": "Language",
          "type": "string"
        }
      },
      "required": [
        "user_login",
        "viewer_count",
        "language"
      ],
      "title": "TwitchStream",
      "type": "object"
    },
    "WikiEdition": {
      "additionalProperties": false,
      "properties": {
        "lang": {
          "description": "Wikipedia language code (en, es, zh-yue, ...)",
          "title": "Lang",
          "type": "string"
        },
        "project": {
          "description": "e.g. en.wikipedia",
          "title": "Project",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "views_last_7d": {
          "title": "Views Last 7D",
          "type": "integer"
        },
        "views_since_launch": {
          "description": "Sum of daily views from launch_day on. 0 while since_launch_pending is true: that 0 means 'not published yet', not 'no views'",
          "title": "Views Since Launch",
          "type": "integer"
        },
        "latest_day": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Latest Day"
        },
        "since_launch_pending": {
          "default": false,
          "description": "True while no day from launch_day on has been fetched for this edition (Wikimedia publishes a day's views some hours after it ends)",
          "title": "Since Launch Pending",
          "type": "boolean"
        }
      },
      "required": [
        "lang",
        "project",
        "title",
        "views_last_7d",
        "views_since_launch",
        "latest_day"
      ],
      "title": "WikiEdition",
      "type": "object"
    },
    "WikipediaSignals": {
      "additionalProperties": false,
      "properties": {
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        },
        "item_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Wikidata item of the GTA VI article",
          "title": "Item Id"
        },
        "window_end": {
          "description": "Last day included in the 7-day window",
          "format": "date",
          "title": "Window End",
          "type": "string"
        },
        "total_last_7d": {
          "title": "Total Last 7D",
          "type": "integer"
        },
        "total_since_launch": {
          "description": "Sum of views_since_launch. 0 while since_launch_pending is true: that 0 means 'not published yet', not 'no views'",
          "title": "Total Since Launch",
          "type": "integer"
        },
        "editions": {
          "description": "views_last_7d desc",
          "items": {
            "$ref": "#/$defs/WikiEdition"
          },
          "title": "Editions",
          "type": "array"
        },
        "launch_day": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "First UTC day counted in the since-launch sums",
          "title": "Launch Day"
        },
        "since_launch_pending": {
          "default": false,
          "description": "True until Wikimedia has published launch_day for any edition. Show 'pending', not total_since_launch",
          "title": "Since Launch Pending",
          "type": "boolean"
        }
      },
      "required": [
        "updated_at",
        "item_id",
        "window_end",
        "total_last_7d",
        "total_since_launch",
        "editions"
      ],
      "title": "WikipediaSignals",
      "type": "object"
    },
    "YouTubeSignals": {
      "additionalProperties": false,
      "properties": {
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        },
        "total_views": {
          "title": "Total Views",
          "type": "integer"
        },
        "videos": {
          "items": {
            "$ref": "#/$defs/YouTubeVideo"
          },
          "title": "Videos",
          "type": "array"
        }
      },
      "required": [
        "updated_at",
        "total_views",
        "videos"
      ],
      "title": "YouTubeSignals",
      "type": "object"
    },
    "YouTubeVideo": {
      "additionalProperties": false,
      "properties": {
        "video_id": {
          "title": "Video Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "views": {
          "title": "Views",
          "type": "integer"
        },
        "likes": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Likes"
        },
        "comments": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Comments"
        },
        "fetched_at": {
          "format": "date-time",
          "title": "Fetched At",
          "type": "string"
        }
      },
      "required": [
        "video_id",
        "label",
        "views",
        "likes",
        "comments",
        "fetched_at"
      ],
      "title": "YouTubeVideo",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "launch_at": {
      "format": "date-time",
      "title": "Launch At",
      "type": "string"
    },
    "twitch": {
      "anyOf": [
        {
          "$ref": "#/$defs/TwitchSignals"
        },
        {
          "type": "null"
        }
      ]
    },
    "steam": {
      "anyOf": [
        {
          "$ref": "#/$defs/SteamSignals"
        },
        {
          "type": "null"
        }
      ]
    },
    "youtube": {
      "anyOf": [
        {
          "$ref": "#/$defs/YouTubeSignals"
        },
        {
          "type": "null"
        }
      ]
    },
    "wikipedia": {
      "anyOf": [
        {
          "$ref": "#/$defs/WikipediaSignals"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "generated_at",
    "launch_at",
    "twitch",
    "steam",
    "youtube",
    "wikipedia"
  ],
  "title": "Signals",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Victor-Nyangi/gta-hype-tracker/collector/schema/signals.schema.json"
}
