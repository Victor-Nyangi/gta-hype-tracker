            }
          ],
          "title": "Latest Day"
        },
        "since_launch_pending": {
          "default": false,
          "description": "True while no day from launch_day on has been fetched for this edition (Wikimedia publishes a day's views some hours after it ends)",
          "title": "Since Launch Pending",
          "type": "boolean"
        }
      },
