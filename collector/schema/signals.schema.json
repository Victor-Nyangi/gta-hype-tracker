{
  "$defs": {
    "BusinessSignals": {
      "additionalProperties": false,
      "properties": {
        "steam_reviews": {
          "anyOf": [
            {
              "$ref": "#/$defs/SteamReviewSignals"
            },
            {
              "type": "null"
            }
          ],
          "description": "Steam review counts and estimated-sales ranges; null until first sampled"
        },
        "official": {
          "anyOf": [
            {
              "$ref": "#/$defs/OfficialFigures"
            },
            {
              "type": "null"
            }
          ],
          "description": "Hand-curated Take-Two figures, each with its source; null if unavailable"
        },
        "prices": {
          "anyOf": [
            {
              "$ref": "#/$defs/PriceSignals"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Daily closes for TTWO, peers and QQQ (Alpha Vantage); null until fetched"
        }
      },
      "required": [
        "steam_reviews",
        "official"
      ],
      "title": "BusinessSignals",
      "type": "object"
    },
    "OfficialFigure": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "description": "Stable id, e.g. gtav_units",
          "title": "Key",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "value": {
          "description": "The figure as reported (units, or US dollars)",
          "title": "Value",
          "type": "integer"
        },
        "value_max": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Upper end when the report gives a range",
          "title": "Value Max"
        },
        "qualifier": {
          "anyOf": [
            {
              "enum": [
                "nearly",
                "over"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "The report's own hedge: 'nearly 235 million' is value 235000000, 'nearly'",
          "title": "Qualifier"
        },
        "unit": {
          "enum": [
            "units",
            "usd"
          ],
          "title": "Unit",
          "type": "string"
        },
        "as_of": {
          "description": "YYYY-MM or YYYY-MM-DD, as precise as the source",
          "pattern": "^\\d{4}-\\d{2}(-\\d{2})?$",
          "title": "As Of",
          "type": "string"
        },
        "source_title": {
          "title": "Source Title",
          "type": "string"
        },
        "source_url": {
          "title": "Source Url",
          "type": "string"
        },
        "quote": {
          "description": "The source's own words for the figure",
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "key",
        "label",
        "value",
        "value_max",
        "qualifier",
        "unit",
        "as_of",
        "source_title",
        "source_url",
        "quote"
      ],
      "title": "OfficialFigure",
      "type": "object"
    },
    "OfficialFigures": {
      "additionalProperties": false,
      "properties": {
        "updated_at": {
          "description": "When the curated list was last checked",
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        },
        "figures": {
          "items": {
            "$ref": "#/$defs/OfficialFigure"
          },
          "title": "Figures",
          "type": "array"
        }
      },
      "required": [
        "updated_at",
        "figures"
      ],
      "title": "OfficialFigures",
      "type": "object"
    },
    "PriceChange": {
      "additionalProperties": false,
      "properties": {
        "from_date": {
          "format": "date",
          "title": "From Date",
          "type": "string"
        },
        "from_close": {
          "title": "From Close",
          "type": "number"
        },
        "to_date": {
          "format": "date",
          "title": "To Date",
          "type": "string"
        },
        "to_close": {
          "title": "To Close",
          "type": "number"
        },
        "change": {
          "description": "to_close minus from_close, USD",
          "title": "Change",
          "type": "number"
        },
        "change_pct": {
          "description": "Percent, e.g. -3.25 for -3.25%",
          "title": "Change Pct",
          "type": "number"
        }
      },
      "required": [
        "from_date",
        "from_close",
        "to_date",
        "to_close",
        "change",
        "change_pct"
      ],
      "title": "PriceChange",
      "type": "object"
    },
    "PricePoint": {
      "additionalProperties": false,
      "properties": {
        "date": {
          "description": "US trading day (New York)",
          "format": "date",
          "title": "Date",
          "type": "string"
        },
        "close": {
          "description": "Unadjusted daily close, USD",
          "title": "Close",
          "type": "number"
        }
      },
      "required": [
        "date",
        "close"
      ],
      "title": "PricePoint",
      "type": "object"
    },
    "PriceSignals": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "description": "Data provider, e.g. Alpha Vantage",
          "title": "Source",
          "type": "string"
        },
        "source_url": {
          "title": "Source Url",
          "type": "string"
        },
        "series": {
          "description": "Which series: daily closes, unadjusted",
          "title": "Series",
          "type": "string"
        },
        "tracking_since": {
          "description": "First fetch that returned closes",
          "format": "date-time",
          "title": "Tracking Since",
          "type": "string"
        },
        "updated_at": {
          "description": "Latest fetch that returned closes",
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        },
        "launch_from": {
          "description": "Last trading day before launch (2026-11-18)",
          "format": "date",
          "title": "Launch From",
          "type": "string"
        },
        "launch_to": {
          "description": "Launch day (2026-11-19)",
          "format": "date",
          "title": "Launch To",
          "type": "string"
        },
        "subject": {
          "description": "Symbol the page leads with (TTWO)",
          "title": "Subject",
          "type": "string"
        },
        "baseline": {
          "description": "Market baseline symbol (QQQ)",
          "title": "Baseline",
          "type": "string"
        },
        "tickers": {
          "items": {
            "$ref": "#/$defs/TickerPrices"
          },
          "title": "Tickers",
          "type": "array"
        },
        "subject_vs_baseline_launch_day": {
          "anyOf": [
            {
              "$ref": "#/$defs/RelativeChange"
            },
            {
              "type": "null"
            }
          ],
          "description": "TTWO vs QQQ over launch_day; null unless both have it"
        },
        "subject_vs_baseline_since_launch": {
          "anyOf": [
            {
              "$ref": "#/$defs/RelativeChange"
            },
            {
              "type": "null"
            }
          ],
          "description": "TTWO vs QQQ over since_launch; null unless both have it"
        }
      },
      "required": [
        "source",
        "source_url",
        "series",
        "tracking_since",
        "updated_at",
        "launch_from",
        "launch_to",
        "subject",
        "baseline",
        "tickers",
        "subject_vs_baseline_launch_day",
        "subject_vs_baseline_since_launch"
      ],
      "title": "PriceSignals",
      "type": "object"
    },
    "RelativeChange": {
      "additionalProperties": false,
      "properties": {
        "subject_pct": {
          "title": "Subject Pct",
          "type": "number"
        },
        "baseline_pct": {
          "title": "Baseline Pct",
          "type": "number"
        },
        "difference_pts": {
          "description": "subject_pct minus baseline_pct, in percentage points (+ beat the market)",
          "title": "Difference Pts",
          "type": "number"
        }
      },
      "required": [
        "subject_pct",
        "baseline_pct",
        "difference_pts"
      ],
      "title": "RelativeChange",
      "type": "object"
    },
    "SalesEstimateMethod": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "description": "One line: how reviews become an estimated-sales range",
          "title": "Name",
          "type": "string"
        },
        "multiplier_low": {
          "description": "Low multiple of all-time reviews",
          "title": "Multiplier Low",
          "type": "integer"
        },
        "multiplier_high": {
          "description": "High multiple of all-time reviews",
          "title": "Multiplier High",
          "type": "integer"
        },
        "sources": {
          "description": "Where the multiples come from (URLs)",
          "items": {
            "type": "string"
          },
          "title": "Sources",
          "type": "array"
        }
      },
      "required": [
        "name",
        "multiplier_low",
        "multiplier_high",
        "sources"
      ],
      "title": "SalesEstimateMethod",
      "type": "object"
    },
    "SteamGame": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "description": "Stable id shared with the web (gtav, rdr2, cs2, ...)",
          "title": "Key",
          "type": "string"
        },
        "app_id": {
          "title": "App Id",
          "type": "integer"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "current_players": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Current Players"
        },
        "current_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Current At"
        },
        "peak_24h": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Max single reading in the 24h before generated_at. When peak_24h_partial is true the readings only go back to peak_24h_since, so this is the max of a shorter window",
          "title": "Peak 24H"
        },
        "observed_peak": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Max single reading since tracking began",
          "title": "Observed Peak"
        },
        "observed_peak_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Observed Peak At"
        },
        "series_24h": {
          "description": "Exactly 25 hourly points, oldest first, ending with the current hour",
          "items": {
            "$ref": "#/$defs/SteamPoint"
          },
          "maxItems": 25,
          "minItems": 25,
          "title": "Series 24H",
          "type": "array"
        },
        "peak_24h_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "When the peak_24h reading was taken (earliest, on a tie)",
          "title": "Peak 24H At"
        },
        "peak_24h_since": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Oldest reading inside the 24h window: where peak_24h's window really starts",
          "title": "Peak 24H Since"
        },
        "peak_24h_partial": {
          "default": false,
          "description": "True when peak_24h_since is more than 15 minutes after generated_at minus 24h (tracking began, or resumed after an outage, inside the window), so peak_24h covers less than 24 hours",
          "title": "Peak 24H Partial",
          "type": "boolean"
        }
      },
      "required": [
        "key",
        "app_id",
        "name",
        "current_players",
        "current_at",
        "peak_24h",
        "observed_peak",
        "observed_peak_at",
        "series_24h"
      ],
      "title": "SteamGame",
      "type": "object"
    },
    "SteamPoint": {
      "additionalProperties": false,
      "properties": {
        "hour": {
          "description": "Start of the UTC hour bucket",
          "format": "date-time",
          "title": "Hour",
          "type": "string"
        },
        "players": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Mean of readings in the hour; null if none",
          "title": "Players"
        }
      },
      "required": [
        "hour",
        "players"
      ],
      "title": "SteamPoint",
      "type": "object"
    },
    "SteamReviewGame": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "description": "Same keys as steam.games (gtav, rdr2, cs2, ...)",
          "title": "Key",
          "type": "string"
        },
        "app_id": {
          "title": "App Id",
          "type": "integer"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "total_reviews": {
          "description": "All-time Steam user reviews, every language",
          "title": "Total Reviews",
          "type": "integer"
        },
        "positive": {
          "title": "Positive",
          "type": "integer"
        },
        "negative": {
          "title": "Negative",
          "type": "integer"
        },
        "fetched_at": {
          "format": "date-time",
          "title": "Fetched At",
          "type": "string"
        },
        "new_reviews_7d": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Reviews posted in the 7 complete UTC days before fetched_at's day, from Steam's own daily counts; null if Steam sent none",
          "title": "New Reviews 7D"
        },
        "change_7d": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "total_reviews minus the total at the latest reading at least 7 days older; null until the tracker has a reading that old",
          "title": "Change 7D"
        },
        "change_7d_since": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "When that older reading was taken",
          "title": "Change 7D Since"
        },
        "estimated_sales_low": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "total_reviews x method.multiplier_low. An estimate, not a reported figure; null where the method does not apply (see no_estimate_reason)",
          "title": "Estimated Sales Low"
        },
        "estimated_sales_high": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "total_reviews x method.multiplier_high",
          "title": "Estimated Sales High"
        },
        "no_estimate_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Why there is no estimate (free to play, a free upgrade), else null",
          "title": "No Estimate Reason"
        }
      },
      "required": [
        "key",
        "app_id",
        "name",
        "total_reviews",
        "positive",
        "negative",
        "fetched_at",
        "new_reviews_7d",
        "change_7d",
        "change_7d_since",
        "estimated_sales_low",
        "estimated_sales_high",
        "no_estimate_reason"
      ],
      "title": "SteamReviewGame",
      "type": "object"
    },
    "SteamReviewSignals": {
      "additionalProperties": false,
      "properties": {
        "tracking_since": {
          "format": "date-time",
          "title": "Tracking Since",
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        },
        "method": {
          "$ref": "#/$defs/SalesEstimateMethod"
        },
        "games": {
          "items": {
            "$ref": "#/$defs/SteamReviewGame"
          },
          "title": "Games",
          "type": "array"
        }
      },
      "required": [
        "tracking_since",
        "updated_at",
        "method",
        "games"
      ],
      "title": "SteamReviewSignals",
      "type": "object"
    },
    "SteamSignals": {
      "additionalProperties": false,
      "properties": {
        "tracking_since": {
          "format": "date-time",
          "title": "Tracking Since",
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        },
        "games": {
          "items": {
            "$ref": "#/$defs/SteamGame"
          },
          "title": "Games",
          "type": "array"
        }
      },
      "required": [
        "tracking_since",
        "updated_at",
        "games"
      ],
      "title": "SteamSignals",
      "type": "object"
    },
    "TickerPrices": {
      "additionalProperties": false,
      "properties": {
        "symbol": {
          "description": "TTWO, EA, SONY, QQQ",
          "title": "Symbol",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "role": {
          "description": "subject: Take-Two; peer: other publishers; baseline: the market (QQQ)",
          "enum": [
            "subject",
            "peer",
            "baseline"
          ],
          "title": "Role",
          "type": "string"
        },
        "closes": {
          "description": "Every daily close the tracker has, oldest first. Merged across fetches, the latest fetch winning per day",
          "items": {
            "$ref": "#/$defs/PricePoint"
          },
          "title": "Closes",
          "type": "array"
        },
        "first_date": {
          "format": "date",
          "title": "First Date",
          "type": "string"
        },
        "latest_date": {
          "format": "date",
          "title": "Latest Date",
          "type": "string"
        },
        "latest_close": {
          "title": "Latest Close",
          "type": "number"
        },
        "fetched_at": {
          "description": "Latest fetch that returned closes for it",
          "format": "date-time",
          "title": "Fetched At",
          "type": "string"
        },
        "launch_day": {
          "anyOf": [
            {
              "$ref": "#/$defs/PriceChange"
            },
            {
              "type": "null"
            }
          ],
          "description": "launch_from close -> launch_to close; null until both are known"
        },
        "since_launch": {
          "anyOf": [
            {
              "$ref": "#/$defs/PriceChange"
            },
            {
              "type": "null"
            }
          ],
          "description": "launch_from close (the last close before launch) -> latest close; null until there is a close after launch_from"
        }
      },
      "required": [
        "symbol",
        "name",
        "role",
        "closes",
        "first_date",
        "latest_date",
        "latest_close",
        "fetched_at",
        "launch_day",
        "since_launch"
      ],
      "title": "TickerPrices",
      "type": "object"
    },
    "TwitchGameSummary": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "title": "Key",
          "type": "string"
        },
        "game_id": {
          "title": "Game Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "current_viewers": {
          "title": "Current Viewers",
          "type": "integer"
        },
        "current_streams": {
          "title": "Current Streams",
          "type": "integer"
        },
        "peak_viewers": {
          "title": "Peak Viewers",
          "type": "integer"
        },
        "peak_at": {
          "format": "date-time",
          "title": "Peak At",
          "type": "string"
        }
      },
      "required": [
        "key",
        "game_id",
        "name",
        "current_viewers",
        "current_streams",
        "peak_viewers",
        "peak_at"
      ],
      "title": "TwitchGameSummary",
      "type": "object"
    },
    "TwitchHourPoint": {
      "additionalProperties": false,
      "properties": {
        "hour": {
          "description": "Start of the UTC hour bucket",
          "format": "date-time",
          "title": "Hour",
          "type": "string"
        },
        "hours_from_launch": {
          "description": "hour minus launch, in whole hours",
          "title": "Hours From Launch",
          "type": "integer"
        },
        "avg_viewers": {
          "title": "Avg Viewers",
          "type": "integer"
        },
        "max_viewers": {
          "title": "Max Viewers",
          "type": "integer"
        },
        "samples": {
          "description": "Snapshots that fell in this hour",
          "title": "Samples",
          "type": "integer"
        }
      },
      "required": [
        "hour",
        "hours_from_launch",
        "avg_viewers",
        "max_viewers",
        "samples"
      ],
      "title": "TwitchHourPoint",
      "type": "object"
    },
    "TwitchLanguage": {
      "additionalProperties": false,
      "properties": {
        "language": {
          "description": "Twitch stream language (ISO 639-1, or 'other')",
          "title": "Language",
          "type": "string"
        },
        "viewers": {
          "title": "Viewers",
          "type": "integer"
        },
        "streams": {
          "title": "Streams",
          "type": "integer"
        },
        "share": {
          "description": "viewers / total viewers, 0..1",
          "title": "Share",
          "type": "number"
        }
      },
      "required": [
        "language",
        "viewers",
        "streams",
        "share"
      ],
      "title": "TwitchLanguage",
      "type": "object"
    },
    "TwitchSignals": {
      "additionalProperties": false,
      "properties": {
        "game_id": {
          "title": "Game Id",
          "type": "string"
        },
        "game_name": {
          "title": "Game Name",
          "type": "string"
        },
        "tracking_since": {
          "description": "First snapshot; nothing before is known",
          "format": "date-time",
          "title": "Tracking Since",
          "type": "string"
        },
        "updated_at": {
          "description": "Latest snapshot",
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        },
        "current_viewers": {
          "title": "Current Viewers",
          "type": "integer"
        },
        "current_streams": {
          "title": "Current Streams",
          "type": "integer"
        },
        "current_truncated": {
          "description": "True if the latest snapshot stopped before the last page (safety page cap, time budget, rate limit or a failing page), so the long tail is not counted",
          "title": "Current Truncated",
          "type": "boolean"
        },
        "peak_viewers": {
          "title": "Peak Viewers",
          "type": "integer"
        },
