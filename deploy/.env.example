# Copy to deploy/.env and fill in. Never commit the filled-in file.
# Every credential is optional: a source without its credentials is skipped (one log line).

# --- routing (required by deploy/compose.yml) ---
# Public hostname for signals.json, e.g. data.example.com (DNS A record -> the box).
DATA_DOMAIN=
# The Docker network snapcount's Traefik proxy is attached to (see deploy/README.md).
TRAEFIK_NETWORK=

# --- sources ---
# Comma-separated subset of: twitch,steam,youtube,wikipedia (empty = all).
COLLECTOR_SOURCES=

# Twitch app (dev.twitch.tv/console): client-credentials flow, no user login.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Optional: skip the by-name lookup of the "Grand Theft Auto VI" category.
TWITCH_GAME_ID=
# Optional: page cap per sample (100 streams per page). Default 100.
TWITCH_MAX_PAGES=

# YouTube Data API v3 key (console.cloud.google.com). Hourly sampling uses ~24 units/day.
YOUTUBE_API_KEY=
# Optional: "id=Label,id=Label". Default: QdBZY2fkU-0=Trailer 1,VQRLujxTm3c=Trailer 2
YOUTUBE_VIDEO_IDS=

# Optional: Wikipedia editions, comma-separated codes, or "all". Default: 30 largest.
WIKI_LANGS=
# Optional: UTC hour for the daily Wikipedia run. Default 6.
WIKI_AT_HOUR_UTC=
# Contact URL sent in the User-Agent (Wikimedia policy). Default: the GitHub repo.
CONTACT_URL=
